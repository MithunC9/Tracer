# Copy to .env (pnpm dev does this for you). Dev-only values; never commit real secrets.

# --- database
# App connections use the restricted role (RLS applies); migrations use the owner/superuser.
DATABASE_URL=postgres://tracer_app:tracer_app@localhost:5432/tracer
DATABASE_ADMIN_URL=postgres://tracer:tracer@localhost:5432/tracer
# DATABASE_POOL_MAX=20
# DATABASE_STATEMENT_TIMEOUT_MS=15000

# --- secrets (the API refuses dev-only values when NODE_ENV=production)
JWT_SECRET=dev-only-change-me-32-bytes-minimum-xxxxxxxx
# 32-byte base64 master key wrapping per-user data keys (envelope encryption)
MASTER_KEY=ZGV2LW9ubHktbWFzdGVyLWtleS0zMi1ieXRlcy0hISE=

# --- HTTP
WEB_ORIGIN=http://localhost:3000
API_PORT=4000
# API_HOST=0.0.0.0
# Cookies are Secure unless disabled; browsers treat http://localhost as secure.
# COOKIE_SECURE=true
# LOG_LEVEL=info
# DOCS_ENABLED=true

# --- web app: where the browser reaches the API
NEXT_PUBLIC_API_URL=http://localhost:4000

# --- LLM: "mock" (default, offline, deterministic) or "anthropic"
LLM_PROVIDER=mock
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# --- limits (defaults shown; see apps/api/SECURITY.md)
# INGEST_RATE_CAPACITY=30
# INGEST_RATE_REFILL_PER_SEC=1
# USER_DAILY_EVENT_QUOTA=200000
# AUTH_RATE_PER_MIN=20
# LOGIN_MAX_FAILURES=5
# ARGON2_MEMORY_KIB=19456
# ARGON2_TIME_COST=2

# --- jobs (pg-boss)
# JOBS_ENABLED=true
# PGBOSS_SCHEMA=pgboss
# JOB_RETRY_LIMIT=3
# JOB_RETRY_DELAY_SECONDS=5
# JOB_RETRY_DELAY_MAX_SECONDS=300
# JOB_POLL_INTERVAL_SECONDS=2
# SWEEP_CRON=* * * * *

# --- observability
# OTEL_ENABLED=false
# OTEL_EXPORTER=otlp
# OTEL_SERVICE_NAME=tracer-api
# METRICS_TOKEN=

# --- demo data (pnpm seed / pnpm dev)
# SEED_PERSONA=bookkeeper        # bookkeeper | freelancer | ops_manager | agency_am | founder
# SEED_VIA=sim                   # sim (tracer-sim, needs Rust) | http (post fixture events)
# LIVE_PERSONA=founder           # persona the live simulated agent replays
# LIVE_SPEED=60                  # replay speed (x real time)
# LIVE_UPLOAD_INTERVAL=10        # seconds between uploads
