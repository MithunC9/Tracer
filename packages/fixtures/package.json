{
  "name": "@tracer/fixtures",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": { "types": "./dist/index.d.ts", "default": "./dist/index.js" },
    "./data/*": "./data/*"
  },
  "files": ["dist", "data"],
  "scripts": {
    "build": "node scripts/ensure-schema.mjs && tsc -p tsconfig.json && node dist/generate.js",
    "typecheck": "node scripts/ensure-schema.mjs && tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "generate": "pnpm run build && node dist/generate.js"
  },
  "dependencies": {
    "@tracer/schema": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "typescript": "~5.9.3",
    "vitest": "^3.2.4"
  }
}
