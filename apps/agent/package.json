{
  "name": "@tracer/agent-ui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Settings window for the Tracer desktop agent (Tauri webview; runs in a plain browser with mock data).",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.json --noEmit && vite build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --root ui",
    "preview": "vite preview"
  },
  "dependencies": {
    "@fontsource/geist": "^5.2.0",
    "@fontsource/geist-mono": "^5.2.0",
    "@fontsource/instrument-serif": "^5.2.0",
    "@tauri-apps/api": "^2.8.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^5.0.0",
    "typescript": "~5.9.3",
    "vite": "^7.1.0",
    "vitest": "^3.2.4"
  }
}
