{
  "name": "@tracer/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "dev": "tsx watch --env-file-if-exists=../../.env src/main.ts",
    "start": "node dist/main.js",
    "migrate": "tsx --env-file-if-exists=../../.env src/scripts/migrate.ts",
    "seed": "tsx --env-file-if-exists=../../.env src/scripts/seed.ts",
    "db:generate": "drizzle-kit generate",
    "load": "node load/ingest.autocannon.mjs"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.5",
    "@fastify/cors": "^11.4.3",
    "@fastify/helmet": "^13.2.0",
    "@fastify/rate-limit": "^11.2.2",
    "@fastify/swagger": "^9.9.5",
    "@fastify/swagger-ui": "^6.1.4",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/exporter-trace-otlp-http": "^0.301.2",
    "@opentelemetry/instrumentation-http": "^0.301.2",
    "@opentelemetry/instrumentation-pg": "^0.78.0",
    "@opentelemetry/resources": "^2.12.0",
    "@opentelemetry/sdk-node": "^0.301.2",
    "@opentelemetry/sdk-trace-base": "^2.12.0",
    "@opentelemetry/semantic-conventions": "^1.45.0",
    "@tracer/schema": "workspace:*",
    "argon2": "^0.45.2",
    "drizzle-orm": "^0.45.4",
    "fastify": "^5.12.8",
    "fastify-type-provider-zod": "^7.0.0",
    "jose": "^6.2.18",
    "pg": "^8.23.1",
    "pg-boss": "^12.38.2",
    "pino": "^10.4.0",
    "prom-client": "^15.1.3",
    "yazl": "^3.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@testcontainers/postgresql": "^12.2.2",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "@types/yauzl": "^3.4.0",
    "@types/yazl": "^3.3.1",
    "autocannon": "^9.0.0",
    "drizzle-kit": "^0.31.11",
    "testcontainers": "^12.2.2",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "vitest": "^3.2.7",
    "yauzl": "^3.4.0"
  }
}
