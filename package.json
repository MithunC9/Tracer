{
  "name": "tracer",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "migrate": "pnpm --filter @tracer/api migrate",
    "seed": "pnpm --filter @tracer/api seed",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "test:e2e": "pnpm --filter @tracer/api test:e2e",
    "verify:reports": "pnpm --filter @tracer/api verify:reports",
    "eval": "pnpm --filter @tracer/analysis eval",
    "openapi": "pnpm --filter @tracer/schema openapi",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "prettier": "^3.6.2",
    "turbo": "^2.5.8",
    "typescript": "~5.9.3",
    "vitest": "^3.2.4"
  }
}
